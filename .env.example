# 环境变量
# 复制此文件为 .env 并填入你的配置

# ============ 链上配置 ============

# Sepolia 测试网 RPC URL（可从 https://chainlist.org/chain/11155111 获取）
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Base Sepolia 测试网 RPC URL（推荐，x402 和 AgentKit 生态所在链）
# 可从 https://chainlist.org/chain/84532 获取
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# 部署账号私钥（不要提交到 Git！）
PRIVATE_KEY=

# Agent 私钥（用于 Agent 签署交易，与部署账号分开）
AGENT_PRIVATE_KEY=

# 部署后的合约地址（部署后填入）
WALLET_CONTRACT_ADDRESS=
POLICY_ENGINE_ADDRESS=
STRATEGY_MANAGER_ADDRESS=

# ============ AI / LLM 配置 ============

# LLM 提供商（可选值：openai / ollama / anthropic / gemini，默认 openai）
LLM_PROVIDER=openai

# LLM 模型名称（可选，不填则使用各提供商默认模型）
# OpenAI 默认: gpt-4o | Ollama 默认: llama3 | Anthropic 默认: claude-sonnet-4-20250514 | Gemini 默认: gemini-2.0-flash
LLM_MODEL=

# LLM API Key（Ollama 本地模型无需配置）
LLM_API_KEY=

# LLM 自定义 API 端点（可选，用于代理或自定义部署）
# Ollama 默认: http://localhost:11434/v1
LLM_BASE_URL=

# ============ 链上验证 ============

# Etherscan API Key（用于 Sepolia 合约验证）
# 获取方式：https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Basescan API Key（用于 Base Sepolia 合约验证）
# 获取方式：https://basescan.org/myapikey
BASESCAN_API_KEY=

# ============ x402 支付配置 ============

# Base 链 RPC URL（x402 支付使用 Base 链）
BASE_RPC_URL=https://mainnet.base.org

# x402 提供者私钥（运行 x402 服务端时需要）
PROVIDER_PRIVATE_KEY=

# ============ Coinbase AgentKit 配置 ============

# Coinbase Developer Platform API Key（使用 AgentKit 时需要）
# 获取方式：https://portal.cdp.coinbase.com/
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
